SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
DATABASE_URL=postgresql://ofauth:local-example-only@127.0.0.1:5438/ofauth_example
APP_ORIGIN=http://127.0.0.1:3000

# Operator mode handles its own private registration. No OFAuth client credentials needed.
OFAUTH_MODE=operator

# Developer mode uses your integration credentials instead.
# OFAUTH_MODE=developer
# OFAUTH_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
# OFAUTH_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
