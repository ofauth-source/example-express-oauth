OFAUTH_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
OFAUTH_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
DATABASE_URL=postgresql://ofauth:local-example-only@127.0.0.1:5438/ofauth_example
APP_ORIGIN=http://127.0.0.1:3000

# Operator private deployments use access:read connections:manage.
# Developer integrations keep the default profile:read.
# OFAUTH_SCOPES=access:read connections:manage
